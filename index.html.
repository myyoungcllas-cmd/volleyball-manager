const seasonLabel=()=>`${s.calendarYear}-${String((s.calendarYear+1)%100).padStart(2,'0')} 시즌`;
const clamp=(v,a=0,b=100)=>Math.max(a,Math.min(b,v));
function positionRanges(){return {L:[155,180],OH:[180,205],MB:[190,218],OP:[183,212],S:[180,200]};}
function rareHeight(){let chance=Math.random();if(s.pos==='L'&&chance<.0005)return 140;if(s.pos==='OH'&&chance<.0005)return 220;if(s.pos==='MB'&&chance<.0005)return 240;if(s.pos==='S'&&chance<.0005)return 210;if(s.pos==='OP'&&chance<.0005)return 220;let r=positionRanges()[s.pos];return rnd(r[0],r[1]);}
function rollRoulette(which){let r=s.roulette;if(which==='height'){r.height=rareHeight();r._rare=[140,220,240,210].includes(r.height);if(r._rare){s.message=`🎆 이스터에그 선수 등장! ${r.height}cm의 초희귀 신체 조건!`;record(s.message);}}else if(which==='reach'){if(s.pos==='OH'&&s.roulette.height===220)r.reach=390;else if(s.pos==='MB'&&s.roulette.height===240)r.reach=400;else if(s.pos==='S'&&s.roulette.height===210)r.reach=375;else if(s.pos==='L'&&s.roulette.height===140)r.reach=rnd(235,250);else r.reach=rnd(Math.max(250,r.height+115),Math.min(s.pos==='L'?315:390,r.height+165));}else{r.weight=Math.max(42,Math.min(125,Math.round((r.height-100)*.9+rnd(-7,7))));}render();}
function makePlayer(){let p={name:s.name,pos:s.pos,height:s.roulette.height,weight:s.roulette.weight,reach:s.roulette.reach,condition:95};let totalCap=s.roulette._rare?365:350;let base={attack:48,serve:45,receive:48,block:45,set:45,speed:48,jump:48};let bias={OH:{attack:18,receive:15,speed:8,jump:7,serve:-4,block:-5,set:-18},OP:{attack:19,jump:14,serve:8,speed:-2,block:5,receive:-15,set:-18},MB:{block:22,jump:20,speed:2,attack:5,serve:0,receive:-17,set:-17},S:{set:24,speed:19,serve:5,block:0,jump:0,receive:-12,attack:-12},L:{receive:24,speed:20,attack:-20,serve:-8,block:-20,set:-15,jump:-18}}[s.pos];keys.forEach(k=>p[k]=clamp(base[k]+(bias[k]||0)+rnd(-4,4),20,90));if(s.pos==='L'&&p.height===140){p.speed=99;p.jump=18;p.attack=20;p.block=20;p.set=35;p.serve=45;p.receive=99;}else if(s.pos==='L'){p.speed=clamp(100-Math.round((p.height-155)*.7)+rnd(-2,2),65,95);p.jump=clamp(rnd(35,55),20,60);}if(s.pos==='OH'&&p.height===220){p.reach=390;p.attack=84;p.receive=82;}if(s.pos==='MB'&&p.height===240){p.reach=400;p.block=92;p.jump=90;}if(s.pos==='S'&&p.height===210){p.reach=375;p.set=92;p.speed=91;}if(s.pos==='OP'&&p.height===220){p.reach=390;p.attack=88;p.jump=86;}let sum=keys.reduce((a,k)=>a+p[k],0);while(sum>totalCap){let candidates=keys.filter(k=>p[k]>(s.pos==='L'&&k==='speed'?99:25));let k=candidates[rnd(0,candidates.length-1)];p[k]--;sum--;}return p;}
function top(){return `<div class="cg-topstats"><div class="cg-mini"><small>팬 여론</small><b>${Number(s.reputation).toFixed(2)}/100</b></div><div class="cg-mini"><small>보유 자금</small><b>${money(s.cash)}</b></div><div class="cg-mini"><small>연봉</small><b>${money(s.salary)}</b></div><div class="cg-mini"><small>구단 신뢰도</small><b>${Number(s.trust).toFixed(2)}/100</b></div></div>`}
function commentsMarkup(){let comments=s.comments.slice(-18).reverse();return `<div class="cg-comments">${comments.map(c=>`<div class="cg-comment"><b>${esc(c.user)} · ${esc(c.time)}</b>${esc(c.text)}</div>`).join('')||'<div class="cg-comment">아직 팬 댓글이 없습니다. 첫 경기를 치르면 실시간 반응이 올라옵니다.</div>'}</div>`}
function addComment(text){let names=['블로킹장인','배구보는사람','오늘도직관','배린이탈출','스파이크덕후','코트사이드','서브에이스'];s.comments.push({user:names[rnd(0,names.length-1)],time:`${rnd(1,59)}분 전`,text});if(s.comments.length>80)s.comments.shift();}
function ratingPage(){let rating=(s.reputation/10).toFixed(2),tone=s.reputation>=80?'폭발적인 호평':s.reputation>=65?'긍정적인 여론':s.reputation>=45?'보통의 평가':s.reputation>=25?'비판적인 여론':'매우 부정적인 여론';return `${card(`<div class="cg-muted">FAN & MEDIA SENTIMENT</div><div class="cg-rating"><div class="cg-rating-score">${rating}<small>/10</small></div><div><h2 style="margin:0 0 5px">${tone}</h2><div class="cg-muted">경기력과 팀 성적에 대한 팬들의 실시간 반응</div></div></div><div class="cg-meter"><span style="width:${s.reputation}%"></span></div><div class="cg-stat"><span>팬 여론</span><b>${Number(s.reputation).toFixed(2)}/100</b></div><h3 style="margin-top:18px">팬 커뮤니티</h3>${commentsMarkup()}`)}${card(`<h3>미디어 반응</h3>${s.history.filter(x=>/여론|팬|이적|연봉|태업|승리|패배|우승/.test(x)).slice(0,8).map(x=>`<div class="cg-event">${esc(x)}</div>`).join('')||'경기 후 미디어 반응이 표시됩니다.'}`)}`}
function playerPage(){if(s.stage==='setup')return `${profile()}${card(`<h3>선수 기본 정보</h3><label>선수 이름</label><input id="name" class="cg-input" maxlength="16" placeholder="선수 이름" value="${esc(s.name)}"><label>포지션</label><div class="cg-grid">${Object.entries(positions).map(([k,v])=>`<button class="cg-choice ${s.pos===k?'selected':''}" data-pos="${k}"><b>${k}</b><div class="cg-muted">${v}</div></button>`).join('')}</div><label>선수 시작 경로 (한 가지만 선택)</label><div class="cg-actions"><button type="button" id="chooseSchool" class="cg-btn ${s.entryType==='school'?'':'alt'}">고등학교 소속</button><button type="button" id="chooseYouth" class="cg-btn ${s.entryType==='youth'?'':'alt'}">유스팀 소속</button></div>${s.entryType==='school'?`<label>고등학교 이름</label><input id="school" class="cg-input" placeholder="예: 진주고등학교" value="${esc(s.school)}"><p class="cg-muted">고등학교 경로를 선택했습니다. 유스팀은 함께 선택할 수 없습니다.</p>`:`<label>유스팀 선택</label><select id="youth" class="cg-select">${youthTeams.map(x=>`<option ${s.youth===x?'selected':''}>${x}</option>`).join('')}</select><p class="cg-muted">유스팀 경로를 선택했습니다. 고등학교 입력은 표시되지 않습니다.</p>`}<h3 style="margin-top:18px">신체 능력 룰렛</h3><p class="cg-muted">버튼 한 번으로 키·최대 타점·몸무게가 함께 다시 결정됩니다. 이름과 소속 선택은 유지됩니다.</p><div class="cg-roulette"><div class="cg-rollbox"><small>키</small><b>${s.roulette.height}cm</b></div><div class="cg-rollbox"><small>최대 타점</small><b>${s.roulette.reach}cm</b></div><div class="cg-rollbox"><small>몸무게</small><b>${s.roulette.weight}kg</b></div></div>${btn('rollAll','신체 조건 다시 뽑기','alt')}${s.roulette._rare?'<div class="cg-fireworks">🎆 🎇 🎆</div>':''}${btn('create','선수 생성')}</div>`)}`;
let injury=s.injury?`<div class="cg-injury"><b>부상 상태 · ${esc(s.injury.name)}</b><div>${s.injury.remaining}경기 결장 예정</div></div>`:`<div class="cg-recovery">현재 부상 없음 · 컨디션 ${s.p.condition}%</div>`;
let records=s.p.pos==='L'?`<div class="cg-grid"><div>디그 성공<div class="cg-big">${s.stats.defenses}</div></div><div>서브 리시브 성공률<div class="cg-big">${s.stats.receiveAttempts?((s.stats.receiveSuccess/s.stats.receiveAttempts)*100).toFixed(2):'0.00'}%</div></div><div>수비 성공률<div class="cg-big">${s.stats.defenseAttempts?(s.stats.defenses/s.stats.defenseAttempts*100).toFixed(2):'0.00'}%</div></div><div>수비 시도<div class="cg-big">${s.stats.defenseAttempts}</div></div></div>`:s.p.pos==='S'?`<div class="cg-grid"><div>토스 성공률<div class="cg-big">${s.stats.setAttempts?(s.stats.setSuccess/s.stats.setAttempts*100).toFixed(2):'0.00'}%</div></div><div>어시스트 비율<div class="cg-big">${s.stats.setAttempts?(s.stats.assists/s.stats.setAttempts*100).toFixed(2):'0.00'}%</div></div><div>토스 횟수<div class="cg-big">${s.stats.setAttempts}</div></div><div>어시스트<div class="cg-big">${s.stats.assists}</div></div></div>`:`<div class="cg-grid"><div>공격 포인트<div class="cg-big">${s.stats.points}</div></div><div>블로킹<div class="cg-big">${s.stats.blocks}</div></div><div>서브 에이스<div class="cg-big">${s.stats.aces}</div></div><div>공격 성공률<div class="cg-big">${s.stats.attackAttempts?(s.stats.attacks/s.stats.attackAttempts*100).toFixed(2):'0.00'}%</div></div></div>`;
