function requestTransfer(){if(!s.salary){alert('프로 계약 이후 이적을 요청할 수 있습니다.');return}if(confirm('구단에 공식 이적 요청서를 제출할까요?')){if(Math.random()<.45){let o=transferOffer();s.league=o.lg;s.club=o.club;s.salary=o.sal;s.reputation=Math.min(100,s.reputation+5);s.message=`이적 요청 승인! ${o.club}으로 이적했습니다.`;record(s.message)}else{let hold=confirm('구단이 이적 요청을 거절했습니다. 태업을 선택할까요?');if(hold){let again=confirm('구단이 태업도 받아들이지 않으면 1년간 시즌 경기에 출전할 수 없습니다. 태업을 강행할까요?');if(again){if(Math.random()<.35){let o=transferOffer();s.league=o.lg;s.club=o.club;s.salary=o.sal;s.reputation=Math.max(0,s.reputation-5);s.message=`태업에 구단이 한발 물러섰습니다. 이적이 승인되어 ${o.club}으로 이동합니다.`;record(s.message)}else{s.holdout=1;s.reputation=Math.max(0,s.reputation-18);s.message='구단이 태업을 받아들이지 않았습니다. 징계로 1년간 시즌 경기에 출전할 수 없습니다.';record(s.message)}}else{s.message='태업을 철회하고 팀에 잔류했습니다.'}}else{s.message='이적 요청을 철회하고 팀에 잔류했습니다.'}}}render()}
function draft(){if(s.league==='대학교 리그'&&![2,4].includes(s.univYear)){alert('대학교 2학년과 4학년 시즌에 드래프트에 도전할 수 있습니다.');return}let chance=Math.min(.95,.15+avg(s.p)/120+s.wins/180+(s.league==='대학교 리그'?s.univYear*.035:0));if(Math.random()<chance){s.league='V-리그';s.club=clubs['V-리그'][rnd(0,clubs['V-리그'].length-1)];s.salary=rnd(50000000,200000000);s.message=`프로 드래프트 성공! ${s.club}에 지명되었습니다.`;record(s.message)}else{s.message='이번 드래프트에서는 지명되지 않았습니다. 현재 리그에서 더 성장하세요.';record(s.message)}render()}
function special(){if(s.stage==='retirement'){s.stage='seasonEnd';s.message='은퇴 권유를 거절하고 현역 생활을 이어갑니다.';}render()}
async function runInternational(){
 if(s.stage!=='national'||s.intlRunning)return;
 s.intlRunning=true;render();
 const rounds=['조별리그','8강 플레이오프','준결승','결승'];let overallWin=true;
 for(let r=0;r<rounds.length;r++){
  const win=Math.random()<Math.min(.88,.48+avg(s.p)/240+(r===3?.04:0));
  const el=document.getElementById('intlphase');
  if(el)el.textContent=`${rounds[r]} · ${win?'대한민국 승리':'대한민국 패배'}`;
  const track=document.getElementById('intlsets');
  if(track){const item=document.createElement('span');item.className='cg-set '+(win?'won':'');item.textContent=rounds[r]+' '+(win?'승리':'패배');track.append(item);}
  const actions=['서브 에이스로 경기 흐름을 가져옵니다','상대의 강한 공격을 안정적으로 리시브합니다','세터의 정확한 토스가 공격수에게 연결됩니다','강력한 스파이크로 득점합니다','블로커가 상대 공격을 차단합니다'];
  for(let i=0;i<actions.length;i++){
   const phase=document.getElementById('intlphase');if(phase)phase.textContent=`${rounds[r]} 하이라이트 · ${actions[i]}`;
   if(!s.skipIntl)await wait(520);
  }
  if(!win){overallWin=false;break;}
 }
 finishInternational(overallWin);
}
function skipInternational(){if(s.stage!=='national')return;if(!s.intlRunning){s.skipIntl=true;runInternational();}else{s.skipIntl=true;}}
function finishInternational(win){s.intlRunning=false;s.skipIntl=false;s.internationalHistory=s.internationalHistory||[];s.internationalHistory.push({year:seasonName(),name:s.tournament,win});if(s.tournament==='아시안게임'){if(win){s.message='아시안게임 금메달! 병역 면제 혜택을 받았습니다.';s.exempt=true;s.reputation=Math.min(100,s.reputation+18)}else{s.message='아시안게임 우승에 실패했습니다. 병역 의무를 수행합니다.';s.service={type:'현역',months:18};s.stage='service';}}else{const event=s.tournament;const award=event==='올림픽'?'올림픽 배구 MVP':event==='VNL'?'VNL MVP':event==='FIVB 세계선수권'?'FIVB 세계선수권 MVP':null;if(win&&award){s.awards.push({year:seasonLabel(),name:award});s.seasonAwards.push(award);}s.message=win?`${event} 우승! 세계 정상에 올랐습니다.`:`${event} 대회를 마쳤습니다.`;s.reputation=Math.min(100,s.reputation+(win?14:5));}if(s.stage!=='service')s.stage='seasonEnd';s.tournament=null;record(s.message);render()}
function enlist(type){if(!s.p||s.exempt||s.service)return;if(s.stage==='national'||s.stage==='match'){alert('경기 또는 국제대회가 진행 중일 때는 입대할 수 없습니다.');return;}if(!confirm(`${type} 입대를 선택할까요? 복무 기간은 18개월입니다.`))return;s.service={type,months:18};s.stage='service';s.message=`${type} 입대. 18개월 복무를 시작합니다.`;record(s.message);render()}
function finishService(){if(!s.service)return;let type=s.service.type;s.age+=1.5;if(type==='상무'){keys.forEach(k=>s.p[k]=Math.min(99,s.p[k]+1));s.message='상무 복무를 마쳤습니다. 체력과 경기 감각을 유지해 복귀합니다.';}else{s.p.condition=Math.max(65,s.p.condition-5);s.message='현역 복무를 마치고 선수 생활에 복귀합니다.';}s.service=null;s.injury=null;s.stage='seasonEnd';record(s.message);render()}

