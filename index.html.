// Season growth: every attribute gets +2; after age 35, age-related decline becomes substantial.
finishSeason = function(){
 const before = Number(s.careerSeasons||0);
 __baseFinishSeason();
 if(!s.p || Number(s.careerSeasons||0)<=before || s._growthAppliedForSeason===s.season) return;
 s._growthAppliedForSeason=s.season;
 const age=Number(s.age||0);
 // The previous career rules already subtracted 1 from speed/jump at 30+ and all stats at 38+.
 // Restore those legacy deductions before applying the new, consistent growth/aging model.
 if(age>=38) keys.forEach(k=>s.p[k]=Math.min(99,(Number(s.p[k])||0)+1));
 if(age>=30) ['speed','jump'].forEach(k=>s.p[k]=Math.min(99,(Number(s.p[k])||0)+1));
 keys.forEach(k=>s.p[k]=Math.min(99,(Number(s.p[k])||0)+2));
 if(age>35){
   const decline=age>=40?8:5;
   keys.forEach(k=>s.p[k]=Math.max(30,(Number(s.p[k])||0)-decline));
   s.message += ` · 만 ${age}세 노화 영향으로 전 능력치 -${decline}`;
 }else{
   s.message += ' · 시즌 성장 보너스: 전 능력치 +2';
 }
 record(s.message);
 render();
};

