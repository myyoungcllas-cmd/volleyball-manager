// GitHub Pages에서 HTML 원문 조각이 텍스트로 노출되는 경우를 방어적으로 정리
(function removeAccidentalSourceDump(){
  const isSourceDump = value => {
    const t = String(value || '');
    return t.length > 120 && /(?:<!doctype\s+html|<html\b|<head\b|<meta\b|--site-primary\s*:|font-family\s*:)/i.test(t);
  };
  const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
  const remove = [];
  while (walker.nextNode()) {
    const node = walker.currentNode;
    if (isSourceDump(node.nodeValue)) remove.push(node);
  }
  remove.forEach(node => node.remove());
  document.querySelectorAll('pre, code').forEach(el => {
    if (isSourceDump(el.textContent)) el.remove();
  });
})();
render();
})();
