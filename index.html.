function rollRoulette(which){const r=s.roulette;if(which==='height'){const rare=Math.random();const rareMap={L:[.00035,140],OH:[.00035,220],MB:[.00035,240],OP:[.00035,220],S:[.00035,210]};if(rare<rareMap[s.pos][0]){r.height=rareMap[s.pos][1];r._rare=true;s.message=`🎆 초희귀 ${s.pos} 포지션 ${r.height}cm 선수 등장!`;record(s.message)}else{const [lo,hi]=posHeights[s.pos];r.height=rnd(lo,hi);r._rare=false;}}else if(which==='reach'){const h=r.height;if(s.pos==='L')r.reach=h===140?250:rnd(250,315);else if(s.pos==='OH')r.reach=390;else if(s.pos==='MB')r.reach=400;else if(s.pos==='OP')r.reach=390;else r.reach=375;}else{r.weight=Math.max(42,Math.min(125,Math.round((r.height-100)*.9+rnd(-7,7))));}render();}
function makePlayer(){const p={name:s.name,pos:s.pos,height:s.roulette.height,weight:s.roulette.weight,reach:s.roulette.reach,condition:95};const bias={OH:{attack:18,receive:15,speed:8,jump:7,serve:-4,block:-5,set:-18},OP:{attack:19,jump:14,serve:8,speed:-2,block:5,receive:-15,set:-18},MB:{block:22,jump:20,speed:2,attack:5,serve:0,receive:-17,set:-17},S:{set:24,speed:19,serve:5,block:0,jump:0,receive:-12,attack:-12},L:{receive:24,speed:20,attack:-20,serve:-8,block:-20,set:-15,jump:-18}}[s.pos];keys.forEach(k=>p[k]=cap(48+(bias[k]||0)+rnd(-4,4),18,95));
