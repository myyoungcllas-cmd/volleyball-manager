function finishSeason(){if(s.stage==='seasonEnd'||s.stage==='national')return;s.last={...s.stats};s.careerSeasons=(s.careerSeasons||0)+1;s.careerPoints=(s.careerPoints||0)+(s.stats.points||0);s.careerMatches=(s.careerMatches||0)+(s.played||0);keys.forEach(k=>s.careerStats[k]=(s.careerStats[k]||0)+(s.stats[k]||0));if(s.salary)s.cash+=s.salary;s.age++;s.training=0;s.trust=clamp(s.trust+15);if(s.loanReturn){s.loanReturn.remaining-=1;if(s.loanReturn.remaining<=0){Object.assign(s,{league:s.loanReturn.league,club:s.loanReturn.club,salary:s.loanReturn.salary});s.loanReturn=null;s.message+=' · 임대 기간 종료, 원소속팀 복귀';}}if(s.age>=30){['speed','jump'].forEach(k=>s.p[k]=Math.max(30,s.p[k]-1));if(s.age>=38)keys.forEach(k=>s.p[k]=Math.max(30,s.p[k]-1))}if(s.age>=40&&(avg(s.p)<=76||Math.random()<.35)){s.stage='retirement';s.message='구단에서 은퇴를 권유했습니다.';record(s.message);return}s.stage='seasonEnd';s.message=`${seasonLabel()} 정규시즌 및 대회 종료 · ${s.wins}승 ${s.losses}패`;record(s.message);if(s.trust<20&&Math.random()<.5){s.stage='retirement';s.message='구단 신뢰도가 20 미만으로 하락해 구단이 방출을 통보했습니다.';record(s.message)}}
