function setAction(stage,side){
 const courtEl=document.querySelector('.cg-court');if(!courtEl)return;
 courtEl.querySelectorAll('.cg-athlete').forEach(el=>el.classList.remove('action-serve','action-receive','action-set','action-spike','action-block','active-player'));
 const ids={serve:1,receive:5,set:6,spike:4,block:3};
 const target=courtEl.querySelector(`.${side}-athlete[data-player="${ids[stage]}"]`);
 if(target)target.classList.add('active-player',`action-${stage}`);
 const ball=document.getElementById('ball');
 // The home side attacks from right to left; the away side attacks from left to right.
 const coords={serve:side==='home'?[82,89]:[18,11],receive:side==='home'?[20,68]:[80,32],set:side==='home'?[68,70]:[32,30],spike:side==='home'?[16,36]:[84,64],block:side==='home'?[50,44]:[50,56]};
 if(ball){const p=coords[stage]||coords.serve;ball.style.left=p[0]+'%';ball.style.top=p[1]+'%';ball.classList.toggle('ball-fast',stage==='spike'||stage==='serve');}
 const route=document.getElementById('route');if(route){const idx={serve:0,receive:1,set:2,spike:3,block:4}[stage];route.querySelectorAll('span').forEach((el,i)=>el.classList.toggle('active',i===idx));}
 const phase=document.getElementById('phase');if(phase)phase.textContent=({serve:'서브: 상대 코트로 공을 보냅니다',receive:'리시브: 수비가 공을 연결합니다',set:'토스: 공격수에게 공을 올립니다',spike:side==='home'?'스파이크! 우리 팀 선수가 네트를 넘어 상대 코트로 강타합니다.':'스파이크! 상대 선수가 네트를 넘어 우리 코트로 강타합니다.',block:'블로킹: 네트 앞에서 공격을 차단합니다'})[stage]||'';
}
async function playHighlight(homeWin,server){
 const cardEl=document.getElementById('highlightCard'),txt=document.getElementById('highlightText');
 if(cardEl)cardEl.classList.add('show');if(txt)txt.textContent=homeWin?'우리 팀의 결정적인 득점 랠리!':'상대 팀의 강한 공격을 막아야 하는 순간!';
 const receiver=server==='home'?'away':'home',attackSide=homeWin?'home':'away',blockSide=attackSide==='home'?'away':'home';
 const sequence=[['serve',server],['receive',receiver],['set',attackSide],['spike',attackSide],['block',blockSide]];
 for(const [stage,side] of sequence){if(s.skipRequested)break;setAction(stage,side);await wait(stage==='spike'?320:210);}
 if(!s.skipRequested){setAction('spike',attackSide);await wait(260);}
}


