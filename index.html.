if(s.pos==='OH'){p.attack=cap(p.attack+(205-p.height)*.08,60,92);p.receive=cap(p.receive+(205-p.height)*.06,55,90);}
if(s.pos==='MB'){p.block=cap(p.block+8,65,95);p.jump=cap(p.jump+8,60,95);}
if(s.pos==='OP'){p.attack=cap(p.attack+5,60,95);p.jump=cap(p.jump+7,60,95);p.serve=cap(p.serve+4,50,90);p.receive=Math.min(p.receive,48);}
if(s.pos==='S'){p.set=cap(p.set+10,65,95);p.speed=cap(p.speed+7,60,95);}
if(s.pos==='OH'&&p.height===220){p.reach=390;p.attack=86;p.receive=82;}if(s.pos==='MB'&&p.height===240){p.reach=400;p.block=94;p.jump=92;}if(s.pos==='OP'&&p.height===220){p.reach=390;p.attack=90;p.jump=87;}if(s.pos==='S'&&p.height===210){p.reach=375;p.set=94;p.speed=92;}
let sum=keys.reduce((a,k)=>a+p[k],0),limit=(s.roulette._rare?365:350);while(sum>limit){let pool=keys.filter(k=>p[k]>(s.pos==='L'&&k==='speed'?99:18));let k=pool[rnd(0,pool.length-1)];p[k]--;sum--;}return p;}
