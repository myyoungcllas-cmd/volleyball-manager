async function advanceSeason(){if(s.running||s.stage!=='playing')return;if(s.service){alert('복무 중에는 시즌 진행 불가');return}s.running=true;for(;s.played<36;s.played++){simulate();s.played--;if(s.calendarYear%4===0&&s.played===20&&s.age>=18){s.running=false;s.stage='national';s.tournament='VNL';s.intlRunning=false;s.message='대표팀에 선발되어 VNL 참가! 시즌 진행이 중단되었습니다.';record(s.message);render();return;}await wait(5)}s.running=false;finishSeason();render()}
