// The visible selector controls the main training focus; two supporting skills also improve.
train = function(){
 if(!s.p || s.stage!=='seasonEnd'){return;}
 if(Number(s.training||0)>=5){return;}
 const chosen=document.getElementById('trainingChoice')?.value||'attack';
 const extras=keys.filter(k=>k!==chosen);
 for(let i=extras.length-1;i>0;i--){const j=rnd(0,i);[extras[i],extras[j]]=[extras[j],extras[i]];}
 const gains=[chosen,...extras.slice(0,2)];
 gains.forEach(k=>s.p[k]=Math.min(99,(Number(s.p[k])||0)+rnd(1,3)));
 s.training=(Number(s.training)||0)+1;
 s.message=`훈련 완료! ${gains.map(k=>labels[k]).join(' · ')} 능력치가 상승했습니다.`;
 record(s.message);render();
};

