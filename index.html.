function ratingPage(){let rating=(s.reputation/10).toFixed(1),tone=s.reputation>=80?'폭발적인 호평':s.reputation>=65?'긍정적인 여론':s.reputation>=45?'보통의 평가':s.reputation>=25?'비판적인 여론':'매우 부정적인 여론';return `${card(`<div class="cg-muted">FAN & MEDIA SENTIMENT</div><div class="cg-rating"><div class="cg-rating-score">${rating}<small>/10</small></div><div><h2 style="margin:0 0 5px">${tone}</h2><div class="cg-muted">경기력, 이적 선택, 팀 성적, 팬과의 관계를 종합한 평점</div></div></div><div class="cg-meter"><span style="width:${s.reputation}%"></span></div><div class="cg-stat"><span>현재 팬 여론</span><b>${s.reputation}/100</b></div><div class="cg-stat"><span>시즌 성적</span><b>${s.wins}승 ${s.losses}패</b></div>`)}${card(`<h3>최근 여론 반응</h3><div class="cg-log">${s.history.filter(x=>/여론|팬|이적|연봉|태업|승리|패배|우승/.test(x)).slice(0,12).map(x=>`<div class="cg-event">${esc(x)}</div>`).join('')||'<div class="cg-event">아직 여론 데이터가 없습니다. 경기와 커리어 선택을 진행하세요.</div>'}</div>`)}${card(`<h3>평점 산정 기준</h3><div class="cg-stat"><span>경기 활약 및 개인 기록</span><b>40%</b></div><div class="cg-stat"><span>팀 성적 및 우승 경쟁</span><b>25%</b></div><div class="cg-stat"><span>이적 선택과 이적료</span><b>25%</b></div><div class="cg-stat"><span>팬과 구단에 대한 태도</span><b>10%</b></div>`)}`}
function shopPage(){const available=s.shop.filter(it=>!(s.owned||[]).includes(it[0])&&!((s.purchaseHistory||[]).some(p=>p.name===it[0]&&p.date===seasonName())));return `${card(`<h2>PLAYER SHOP</h2><p class="cg-muted">시즌마다 6개 상품이 무작위 입고됩니다. 구매한 상품은 상점 목록에서 사라집니다.</p><div class="cg-grid">${available.map((it,i)=>`<div class="cg-shop"><span class="cg-pill">${it[2]}</span><b>${esc(it[0])}</b><div class="cg-big" style="font-size:19px">${money(it[1])}</div><div class="cg-shop-effect">${it[3]==='heal'?`회복 아이템 · 회복 단계 ${it[4]}`:it[3]==='all'?`전체 능력치 +${it[4]}`:`${labels[it[3]]||'컨디션'} +${it[4]}`}</div>${btn('buy'+s.shop.indexOf(it),'구매하기')}</div>`).join('')||'<div class="cg-muted">현재 구매 가능한 상품이 없습니다. 다음 시즌 상점 입고를 기다려 주세요.</div>'}</div><div class="cg-muted" style="margin-top:10px">보유 상품: ${s.owned.length?s.owned.map(esc).join(' · '):'없음'}</div><p class="cg-muted">회복용품을 구매하면 즉시 사용됩니다. 일반 장비와 훈련 상품은 구매 즉시 능력치에 반영됩니다.</p>`)}`}
function playerPage(){
if(s.stage==='setup')return `${profile()}${card(`<h3>선수 기본 정보</h3><label>선수 이름</label><input id="name" class="cg-input" maxlength="16" placeholder="선수 이름" value="${esc(s.name)}"><label>포지션</label><div class="cg-grid">${Object.entries(positions).map(([k,v])=>`<button class="cg-choice ${s.pos===k?'selected':''}" data-pos="${k}"><b>${k}</b><div class="cg-muted">${v}</div></button>`).join('')}</div><label>선수 시작 경로 (둘 중 하나만 선택)</label><div class="cg-actions"><button type="button" id="chooseSchool" class="cg-btn ${s.entryType==='school'?'':'alt'}">고등학교 소속</button><button type="button" id="chooseYouth" class="cg-btn ${s.entryType==='youth'?'':'alt'}">유스팀 소속</button></div>${s.entryType==='school'?`<label>고등학교 이름</label><input id="school" class="cg-input" placeholder="예: 진주고등학교" value="${esc(s.school)}"><p class="cg-muted">고등학교를 선택하면 유스팀은 선택할 수 없습니다.</p>`:`<label>유스팀 선택</label><select id="youth" class="cg-select">${youthTeams.map(x=>`<option ${s.youth===x?'selected':''}>${x}</option>`).join('')}</select><p class="cg-muted">유스팀을 선택하면 고등학교 입력은 사용하지 않습니다.</p>`}<h3 style="margin-top:18px">신체 능력 룰렛</h3><p class="cg-muted">버튼 한 번으로 키·최대 타점·몸무게가 함께 다시 결정됩니다. 이름과 학교 정보는 유지됩니다.</p><div class="cg-roulette"><div class="cg-rollbox"><small>키</small><b>${s.roulette.height}cm</b></div><div class="cg-rollbox"><small>최대 타점</small><b>${s.roulette.reach}cm</b></div><div class="cg-rollbox"><small>몸무게</small><b>${s.roulette.weight}kg</b></div></div>${btn('rollAll','신체 조건 다시 뽑기','alt')}${btn('create','선수 생성')}</div>`)}`;
let injury=s.injury?`<div class="cg-injury"><b>부상 상태 · ${esc(s.injury.name)}</b><div>${s.injury.remaining}경기 결장 예정 · 능력치 일시 감소</div></div>`:`<div class="cg-recovery">현재 부상 없음 · 컨디션 ${s.p.condition}%</div>`;
let offseason=s.stage==='seasonEnd'?(s.season>=2?`<div class="cg-offseason"><b>시즌 종료 훈련 · ${s.training}/5회 사용</b><p class="cg-muted">훈련 비용은 없습니다. 비시즌에 최대 5회까지 원하는 능력치를 강화할 수 있습니다.</p><select id="trainStat" class="cg-select">${keys.map(k=>`<option value="${k}">${labels[k]}</option>`).join('')}</select>${btn('train',s.training>=5?'훈련 5회 완료':'훈련하기')}${btn('next','다음 시즌으로','alt')}</div>`:`<div class="cg-offseason"><b>첫 시즌 적응 기간</b><p class="cg-muted">첫 시즌에는 훈련할 수 없습니다. 두 번째 시즌부터 비시즌 훈련이 열립니다.</p>${btn('next','다음 시즌으로','alt')}</div>`):'';
return `${profile()}${card(`<h3>선수 신체 정보</h3><div class="cg-stat"><span>키</span><b>${s.p.height}cm</b></div><div class="cg-stat"><span>최대 타점</span><b>${s.p.reach}cm</b></div><div class="cg-stat"><span>몸무게</span><b>${s.p.weight}kg</b></div>`)}${card(`<h3>선수 능력치</h3>${keys.map(k=>`<div class="cg-stat"><span>${labels[k]}</span><b>${s.p[k]}</b></div>`).join('')}<div class="cg-stat"><span>컨디션</span><b>${s.p.condition}%</b></div>${injury}${offseason}`)}${card(`<h3>선수 기록</h3><div class="cg-grid"><div>공격 포인트<div class="cg-big">${s.stats.points}</div></div><div>블로킹<div class="cg-big">${s.stats.blocks}</div></div><div>서브 에이스<div class="cg-big">${s.stats.aces}</div></div><div>수비 성공<div class="cg-big">${s.stats.defenses}</div></div><div>공격 성공률<div class="cg-big">${s.stats.attackAttempts?Math.round(s.stats.attacks/s.stats.attackAttempts*100):0}%</div></div><div>수비 성공률<div class="cg-big">${s.stats.defenseAttempts?Math.round(s.stats.defenses/s.stats.defenseAttempts*100):0}%</div></div></div>`)}${card(`<h3>병역 및 커리어 선택</h3>${s.exempt?'<div class="cg-positive">아시안게임 또는 올림픽 우승으로 병역 면제 상태입니다.</div>':s.service?`<div class="cg-muted">${s.service.type} 복무 중 · ${s.service.months}개월 남음</div>${btn('finishservice','복무 완료 후 복귀')}`:`<p class="cg-muted">선수 생활 중 원하는 시점에 상무 또는 현역으로 입대할 수 있습니다. 복무 중에는 경기에 출전하지 않습니다.</p><div class="cg-actions">${btn('sangmu','상무로 입대하기','alt')}${btn('activeDuty','현역으로 입대하기','alt')}</div>`}`)}`
}

function careerPage(){
 const awards=s.awards||[];const groups={};awards.forEach(a=>(groups[a.year]??=[]).push(a.name));
 return `${card(`<div class="cg-muted">CAREER HALL OF FAME</div><h2>커리어 명예의 전당</h2><div class="cg-grid"><div>활동 시즌<div class="cg-big">${s.careerSeasons||s.season-1}</div></div><div>통산 공격 포인트<div class="cg-big">${s.careerPoints||s.careerStats?.points||0}</div></div><div>통산 경기<div class="cg-big">${s.careerMatches||s.matchCount||0}</div></div><div>수상 개수<div class="cg-big">${awards.length}</div></div></div>`)}
 ${card(`<h3>주요 개인상</h3>${['FIVB 올해의 선수','20세기의 최고의 선수상','올림픽 배구 MVP','FIVB 세계선수권 MVP','VNL MVP','CEV 챔피언스리그 MVP'].map(n=>`<div class="cg-stat"><span>${n}</span><b>${awards.filter(a=>a.name===n).length}회</b></div>`).join('')}`)}
 ${card(`<h3>시즌별 수상 기록</h3>${Object.keys(groups).length?Object.entries(groups).reverse().map(([y,ns])=>`<div class="cg-transfer"><b>${esc(y)} 시상식</b>${ns.map(n=>`<div class="cg-event">🏆 ${esc(n)}</div>`).join('')}</div>`).join(''):'<div class="cg-muted">아직 수상 기록이 없습니다.</div>'}`)}
 ${card(`<h3>국제대회 기록</h3>${(s.internationalHistory||[]).slice().reverse().map(x=>`<div class="cg-stat"><span>${esc(x.year)} · ${esc(x.name)}</span><b>${x.win?'우승':'대회 종료'}</b></div>`).join('')||'<div class="cg-muted">국제대회 기록이 없습니다.</div>'}`)}
 ${s.retirementSummary?card(`<h2>은퇴 커리어 총결산</h2><div class="cg-grid"><div>총 활동 시즌<div class="cg-big">${s.retirementSummary.seasons}</div></div><div>총 공격 포인트<div class="cg-big">${s.retirementSummary.points}</div></div><div>총 경기<div class="cg-big">${s.retirementSummary.matches}</div></div><div>총 수상<div class="cg-big">${s.retirementSummary.awards}</div></div></div>${btn('newlife','새 삶을 시작하기','alt')}`):''}`;
}
function ceremonyPage(){const list=s.seasonAwards||[];return card(`<div class="cg-muted">END OF SEASON · AWARDS NIGHT</div><h2 style="font-size:28px">🏆 시즌 시상식</h2><div class="cg-rating"><div class="cg-rating-score">${list.length}</div><div><h3>올해의 수상</h3><div class="cg-muted">${seasonName()} 시즌 공식 시상식</div></div></div>${s.mvpRace?card(`<h3>🏅 정규시즌 MVP 경쟁 결과</h3><div class="cg-positive">MVP 수상자: <b>${esc(s.mvpRace.winner.name)}</b> · ${s.mvpRace.winner.score}점 ${s.mvpRace.winner.isPlayer?'(나의 수상!)':'(라이벌 수상)'}</div>${s.mvpRace.contenders.map((r,i)=>`<div class="cg-stat"><span>${i+1}위 · ${esc(r.name)} (${esc(r.club)})${r.isPlayer?' · 나':''}</span><b>${r.score}점</b></div>`).join('')}`):''}${list.length?list.map((n,i)=>`<div class="cg-transfer" style="border-color:${n==='20세기의 최고의 선수상'?'#f5d36b':'#d8f36a'};background:${n==='20세기의 최고의 선수상'?'linear-gradient(135deg,#49351b,#17252a)':'#0a2027'};padding:${n==='20세기의 최고의 선수상'?'26px':'12px'}"><div class="cg-muted">${n==='20세기의 최고의 선수상'?'✦ THE IMMORTAL LEGEND · GRAND CEREMONY':String(i+1).padStart(2,'0')+' · AWARD WINNER'}</div><h3>🏆 ${esc(n)}</h3><b>${esc(n===s.mvpAward?.name?(s.mvpAward?.recipient||s.p?.name||'선수'):(s.p?.name||'선수'))}</b></div>`).join(''):'<div class="cg-muted">이번 시즌 수상 내역은 없습니다. 다음 시즌을 준비하세요.</div>'}${btn('next','시상식 종료 · 다음 시즌으로')}</div>`)}
function teamPage(){if(!s.p)return card('<h2>선수를 먼저 생성하세요.</h2>');let pro=leagues.slice(2).includes(s.league);return `${card(`<h2>TEAM MANAGEMENT</h2><div class="cg-stat"><span>현재 소속</span><b>${esc(s.club||s.school)}</b></div><div class="cg-stat"><span>리그</span><b>${esc(s.league)}</b></div><div class="cg-stat"><span>시즌 순위</span><b>${s.teamRank}위 / 10팀</b></div><div class="cg-stat"><span>팀 성적</span><b>${s.wins}승 ${s.losses}패</b></div><div class="cg-actions">${btn('offers','이적 제의 확인','alt')}${btn('raise','연봉 인상 요청','alt')}${btn('request','이적 요청','alt')}${(s.league==='고교 리그'||(s.league==='대학교 리그'&&[2,4].includes(s.univYear)))?btn('draft','프로 드래프트 도전','alt'):''}</div><p class="cg-muted">이적 요청을 구단이 거절하면 태업을 선택할 수 있습니다. 태업마저 거절되면 1년간 공식 시즌 경기에 출전하지 못합니다.</p>`)}${card(`<h3>리그 순위표</h3>${Array.from({length:10},(_,i)=>{let name=(clubs[s.league]||['우리 학교 팀']).concat(['오션즈','레인저스','스톰','블레이즈','유나이티드'])[i%((clubs[s.league]||['우리 학교 팀']).length+5)];return `<div class="cg-stat"><span>${i+1}위 · ${i===Math.min(9,s.teamRank-1)?'★ ':''}${esc(name||'라이벌 클럽')}</span><b>${Math.max(0,36-i*3)}승 ${i*2}패</b></div>`}).join('')}`)}${card(`<h3>팀 커리어 기록</h3><div class="cg-stat"><span>시즌</span><b>${s.season}</b></div><div class="cg-stat"><span>시즌 경기 진행</span><b>${s.played}/36</b></div><div class="cg-stat"><span>팀 누적 승리</span><b>${s.teamWins}</b></div><div class="cg-stat"><span>팀 누적 패배</span><b>${s.teamLosses}</b></div>`)}`}
function court(){let home=['OH','MB','OP','S','MB','OH'],away=['OH','MB','OP','S','MB','OH'];return `<div class="cg-court-wrap"><div class="cg-court"><div class="cg-side home">${home.map((x,i)=>`<div class="cg-athlete"><div class="cg-jersey">${i+1}</div>${x}</div>`).join('')}</div><div class="cg-net"></div><div class="cg-side away">${away.map((x,i)=>`<div class="cg-athlete"><div class="cg-jersey">${i+1}</div>${x}</div>`).join('')}</div><div class="cg-ball" id="ball">🏐</div></div><div class="cg-route" id="route"><span>① 서브</span><span>② 리시브</span><span>③ 토스</span><span>④ 스파이크</span></div></div>`}
function playPage(){
 if(s.stage==='setup')return card('<h2>선수 생성 후 경기를 시작할 수 있습니다.</h2>');
 if(s.stage==='seasonEnd')return card(`<h2>시즌 ${s.season} 종료</h2><div class="cg-big">${s.wins}승 ${s.losses}패</div><div class="cg-grid"><div>공격 포인트<h3>${s.last?.points||0}</h3></div><div>블로킹<h3>${s.last?.blocks||0}</h3></div><div>서브 에이스<h3>${s.last?.aces||0}</h3></div><div>수비 성공<h3>${s.last?.defenses||0}</h3></div></div><div class="cg-offseason" style="margin-top:12px">비시즌 훈련을 선수 탭에서 최대 5회 진행할 수 있습니다.</div><div class="cg-actions">${btn('next','다음 시즌으로')}</div>`);
 if(s.stage==='national')return card(`<div class="cg-muted">INTERNATIONAL FINAL · ${s.tournament}</div><h2>${esc(s.tournament)} 결승전</h2><p class="cg-muted">국가대표팀이 결승전에 진출했습니다. 결승전 하이라이트만 확인할 수 있습니다.</p><div class="cg-scoreboard"><div class="cg-highlight" id="intlphase">${s.intlRunning?'결승전 진행 중…':'결승전 대기 중'}</div><div class="cg-scoreline"><div><div class="cg-muted">대한민국</div><div class="cg-points" id="intlhome">0</div></div><b>VS</b><div><div class="cg-muted">${esc(s.intlOpponent||'상대 국가')}</div><div class="cg-points" id="intlaway">0</div></div></div><div class="cg-settrack" id="intlsets"></div></div><div class="cg-actions">${btn('runintl',s.intlRunning?'결승전 진행 중…':'결승 하이라이트 보기')}${btn('skipintl','건너뛰기','skip')}</div><p class="cg-muted">결승전은 5세트 3선승제로 간략한 주요 장면만 재생됩니다.</p>`);
